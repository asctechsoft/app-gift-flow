    <string name="terms_title">Terms of use</string>
    <string name="privacy_s1_t">Data we store</string>
    <string name="privacy_s1_b">Guest names, relationships, amounts and notes you enter are stored on your device and, when sync is on, on the GiftFlow server for backup and multi-device use.</string>
    <string name="privacy_s2_t">Microphone and voice</string>
    <string name="privacy_s2_b">The microphone only turns on while the recording screen is open. Speech is converted to text on your phone; only the text (never audio) is sent to the server so AI can extract name and amount.</string>
    <string name="privacy_s3_t">AI service</string>
    <string name="privacy_s3_b">The text goes to the AI provider through the GiftFlow server. The AI access key lives only on the server, never in the app. We do not write what you said into system logs.</string>
    <string name="privacy_s4_t">Your rights</string>
    <string name="privacy_s4_b">You can edit or delete any record, export all data to Excel and sign out at any time.</string>
    <string name="terms_s1_t">Purpose</string>
    <string name="terms_s1_b">GiftFlow AI helps record and summarize gift money. Figures you confirm are final; AI results are suggestions and must be reviewed when the app says \"Needs review\".</string>
    <string name="terms_s2_t">Responsibility</string>
    <string name="terms_s2_b">You are responsible for the accuracy of the data you enter and confirm. Back up or export to Excel regularly.</string>
    <string name="terms_s3_t">Changes</string>
    <string name="terms_s3_b">We may update features and terms. Continued use after an update means you accept the new terms.</string>
