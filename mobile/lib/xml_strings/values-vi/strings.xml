    <string name="privacy_s1_t">Dữ liệu chúng tôi lưu</string>
    <string name="privacy_s1_b">Tên khách, quan hệ, số tiền và ghi chú bạn nhập được lưu trên máy của bạn và, khi bật đồng bộ, trên máy chủ GiftFlow để sao lưu và dùng trên nhiều thiết bị.</string>
    <string name="privacy_s2_t">Micro và giọng nói</string>
    <string name="privacy_s2_b">Micro chỉ bật khi bạn mở màn hình ghi âm. Giọng nói được chuyển thành chữ ngay trên điện thoại; app chỉ gửi đoạn chữ (không gửi file âm thanh) lên máy chủ để AI tách tên và số tiền.</string>
    <string name="privacy_s3_t">Dịch vụ AI</string>
    <string name="privacy_s3_b">Đoạn chữ được gửi tới nhà cung cấp AI qua máy chủ của GiftFlow. Khóa truy cập AI chỉ nằm ở máy chủ, không nằm trong ứng dụng. Chúng tôi không ghi nội dung câu nói vào nhật ký hệ thống.</string>
    <string name="privacy_s4_t">Quyền của bạn</string>
    <string name="privacy_s4_b">Bạn có thể sửa hoặc xóa từng bản ghi trong ứng dụng, xuất toàn bộ dữ liệu ra Excel và đăng xuất bất cứ lúc nào.</string>
    <string name="terms_s1_t">Mục đích sử dụng</string>
    <string name="terms_s1_b">GiftFlow AI giúp ghi nhận và thống kê tiền mừng. Số liệu do bạn xác nhận là căn cứ cuối cùng; kết quả AI chỉ là gợi ý và cần được kiểm tra khi app báo \"Cần kiểm tra\".</string>
    <string name="terms_s2_t">Trách nhiệm</string>
    <string name="terms_s2_b">Bạn chịu trách nhiệm về tính chính xác của dữ liệu đã nhập và xác nhận. Hãy sao lưu hoặc xuất Excel định kỳ để tránh mất dữ liệu.</string>
    <string name="terms_s3_t">Thay đổi</string>
    <string name="terms_s3_b">Chúng tôi có thể cập nhật tính năng và điều khoản. Việc tiếp tục sử dụng sau khi cập nhật đồng nghĩa bạn đồng ý với nội dung mới.</string>
