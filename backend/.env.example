# ---- Runtime ----
NODE_ENV=development
PORT=3000
# Dev: sqljs (file) | Prod: postgres
DB_TYPE=sqljs
SQLJS_FILE=./data/giftflow.sqlite
DATABASE_URL=postgres://giftflow:CHANGE_ME@postgres:5432/giftflow

# ---- Auth (đổi thành chuỗi ngẫu nhiên dài, KHÔNG commit) ----
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# ---- AI ----
# mock = chạy được ngay không cần key (dev/demo). openai = dùng API thật.
AI_PROVIDER=mock
# Token/API key AI: điền sau khi bạn có. CHỈ nằm ở backend, không bao giờ đưa vào app/git.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Tên model KHÔNG hardcode - chọn sau khi benchmark.
STT_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1

# ---- Giới hạn / quota ----
QUOTA_LIMIT_PER_PERIOD=300
MAX_AMOUNT_VND=1000000000
MAX_AUDIO_BYTES=3145728
MAX_AUDIO_SECONDS=30
DUPLICATE_WINDOW_MINUTES=10
STORE_TRANSCRIPT=true
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60

# ---- Export / CORS / Docs ----
EXPORT_DIR=./exports
EXPORT_TTL_MINUTES=30
CORS_ORIGINS=
DOCS_ENABLED=true

# ---- Infra (docker compose) ----
POSTGRES_PASSWORD=CHANGE_ME
API_DOMAIN=api.example.com

# ---- Đăng nhập Google (Web client ID của OAuth, cách nhau bởi dấu phẩy) ----
GOOGLE_CLIENT_IDS=

# ---- Bảo mật / chống lạm dụng ----
# Firebase App Check: off | monitor (log, không chặn) | enforce (thiếu/sai token -> 401)
APP_CHECK_MODE=off
# Số dự án Firebase (Project settings > Project number)
FIREBASE_PROJECT_NUMBER=
# App id Android Firebase được phép (claim sub), phân tách bằng dấu phẩy; trống = mọi app của dự án
APP_CHECK_APP_IDS=
# Trần tổng lượt AI/ngày của TOÀN hệ thống (công tắc ngắt chi phí OpenAI); 0 = không giới hạn
AI_GLOBAL_DAILY_LIMIT=3000
# Số tài khoản khách mới tối đa mỗi IP mỗi ngày
NEW_GUESTS_PER_IP_PER_DAY=20
